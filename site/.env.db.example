# The database connection for scripts/db.sh (npm run db:*). Copy to .env.db and
# paste the Session pooler URI: Supabase dashboard → Connect → Session pooler,
# with [YOUR-PASSWORD] replaced by the database password. Never NEXT_PUBLIC_,
# never committed, and Next does not load this file. Keep THIS file as it is:
# it is committed, so it must never hold a real password.
SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
